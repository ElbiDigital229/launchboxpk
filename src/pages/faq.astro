// One FAQPage for this URL. Each FAQs widget below passes emitSchema={false} so the
// page declares a single consolidated entity rather than one per section.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://www.launchboxpk.com/faq#faq',
  mainEntity: groups
    .flatMap((g) => g.items)
    .map((it) => ({
      '@type': 'Question',
      name: it.title,
      acceptedAnswer: { '@type': 'Answer', text: it.description },
    })),
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Frequently Asked"
    title="Every question you had, answered plainly."
    subtitle="Pricing, plans, internet, power, meeting rooms, where we are — no asterisks, no fine print, just the facts about coworking at Launchbox in DHA Phase 5, Lahore."
  />

  {
    groups.map((group, i) => (
      <FAQs title={group.title} columns={1} items={group.items} emitSchema={false}>
        {i % 2 === 1 && (
          <Fragment slot="bg">
            <div class="absolute inset-0 bg-green-50 dark:bg-transparent" />
          </Fragment>
        )}
      </FAQs>
    ))
  }

  <CallToAction
    title="Still have questions?"
    subtitle="Visit the space or message us on WhatsApp. We're happy to help."
    actions={[
      { variant: 'primary', text: 'Book a visit', href: '/book-visit' },
      { target: '_blank', text: 'WhatsApp us', href: 'https://wa.me/923070555515' },
    ]}
  />

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
</Layout>
