---
import Layout from '~/layouts/PageLayout.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import jobsData from '~/data/jobs.json';

const metadata = {
  title: 'Pakistan Tech Jobs Board',
  description:
    'Curated tech jobs in Pakistan — engineering, design, product, data. Auto-refreshed from Rozee.pk and other portals every 6 hours.',
};

interface Job {
  id: string;
  source: string;
  sourceLabel: string;
  sourceId: string;
  title: string;
  company: string;
  location: string;
  workMode: string;
  type: string;
  experience: string | null;
  contractType: string | null;
  postedDate: string | null;
  url: string;
}

interface SourceResult {
  id: string;
  label: string;
  count: number;
  error?: string;
}

const jobs = (jobsData.jobs || []) as Job[];
const sources = (jobsData.sources || []) as SourceResult[];

// ---- City normalization --------------------------------------------------
// Rozee.pk typically returns a single city ("Lahore", "Karachi"). Trim to first
// part of the location string and title-case so "lahore" / "LHR" don't fragment.
function titleCase(s: string) {
  return s
    .toLowerCase()
    .replace(/\b\w/g, (c) => c.toUpperCase())
    .replace(/\b(Pk|Pakistan)\b/g, 'Pakistan');
}
function normalizeCity(loc: string): string {
  const first = (loc || '').split(',')[0].trim();
  if (!first) return '';
  // Common abbreviations
  const map: Record<string, string> = {
    Lhr: 'Lahore',
    Khi: 'Karachi',
    Isb: 'Islamabad',
    Rwp: 'Rawalpindi',
    Fsd: 'Faisalabad',
  };
  const t = titleCase(first);
  return map[t] || t;
}

// Sort by postedDate desc — fall back to original order if unparseable
function dateMs(d: string | null) {
  if (!d) return 0;
  const t = Date.parse(d);
  return Number.isNaN(t) ? 0 : t;
}

// Decorate each job with normalized city — used for filtering and rendering.
const decorated = jobs.map((j) => ({ ...j, city: normalizeCity(j.location) }));
const sortedJobs = [...decorated].sort((a, b) => dateMs(b.postedDate) - dateMs(a.postedDate));

// ---- Facets with counts --------------------------------------------------
function bumpCount(map: Map<string, number>, key: string) {
  if (!key) return;
  map.set(key, (map.get(key) || 0) + 1);
}

const cityCount = new Map<string, number>();
const modeCount = new Map<string, number>();
const typeCount = new Map<string, number>();
const sourceCount = new Map<string, number>();
for (const j of decorated) {
  bumpCount(cityCount, j.city);
  bumpCount(modeCount, j.workMode);
  bumpCount(typeCount, j.type);
  bumpCount(sourceCount, j.source);
}

// Top 10 cities by job count (the long tail rarely has more than 1 each).
const topCities = [...cityCount.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 12);

// Only show modes that actually exist in the data, and skip "unknown" — it's
// noise for the user (Rozee.pk leaves work mode unset on most postings).
const visibleModes = (['remote', 'hybrid', 'on-site'] as const)
  .map((m) => ({ value: m, count: modeCount.get(m) || 0 }))
  .filter((m) => m.count > 0);

const visibleTypes = [...typeCount.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([value, count]) => ({ value, count }));

const visibleSources = [...sourceCount.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([value, count]) => {
    const meta = sources.find((s) => s.id === value);
    return { value, count, label: meta?.label || value };
  });

const PER_PAGE = 20;

// Mode → user-facing label (cards still store the canonical value).
const MODE_LABEL: Record<string, string> = {
  remote: 'Remote',
  hybrid: 'Hybrid',
  'on-site': 'On-site',
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-6xl px-4 py-10">
    <div class="grid gap-10 md:grid-cols-[240px_1fr]">
      <!-- Filters sidebar -->
      <aside class="md:sticky md:top-24 md:self-start space-y-7">
        <!-- Search -->
        <div class="relative">
          <input
            id="jobs-search"
            type="search"
            placeholder="Search…"
            class="w-full rounded-md border border-gray-200 dark:border-slate-700 bg-transparent pl-9 pr-3 py-2 text-sm placeholder-gray-400 focus:border-primary focus:outline-none focus:ring-0"
            autocomplete="off"
          />
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <!-- City -->
        {topCities.length > 0 && (
          <div>
            <h3 class="text-[13px] font-medium text-gray-500 dark:text-slate-400 mb-3">City</h3>
            <ul class="space-y-1.5">
              {topCities.map(([name, count]) => (
                <li>
                  <button
                    type="button"
                    class="filter-row group flex w-full items-center justify-between text-left text-sm text-gray-700 dark:text-slate-300 hover:text-primary transition-colors"
                    data-group="city"
                    data-value={name}
                  >
                    <span class="filter-label">{name}</span>
                    <span class="text-xs tabular-nums text-gray-400 dark:text-slate-500">{count}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Setup -->
        {visibleModes.length > 0 && (
          <div>
            <h3 class="text-[13px] font-medium text-gray-500 dark:text-slate-400 mb-3">Setup</h3>
            <ul class="space-y-1.5">
              {visibleModes.map(({ value, count }) => (
                <li>
                  <button
                    type="button"
                    class="filter-row group flex w-full items-center justify-between text-left text-sm text-gray-700 dark:text-slate-300 hover:text-primary transition-colors"
                    data-group="mode"
                    data-value={value}
                  >
                    <span class="filter-label">{MODE_LABEL[value] || value}</span>
                    <span class="text-xs tabular-nums text-gray-400 dark:text-slate-500">{count}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Type -->
        {visibleTypes.length > 0 && (
          <div>
            <h3 class="text-[13px] font-medium text-gray-500 dark:text-slate-400 mb-3">Type</h3>
            <ul class="space-y-1.5">
              {visibleTypes.map(({ value, count }) => (
                <li>
                  <button
                    type="button"
                    class="filter-row group flex w-full items-center justify-between text-left text-sm text-gray-700 dark:text-slate-300 hover:text-primary transition-colors"
                    data-group="type"
                    data-value={value}
                  >
                    <span class="filter-label">{value}</span>
                    <span class="text-xs tabular-nums text-gray-400 dark:text-slate-500">{count}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Source -->
        {visibleSources.length > 1 && (
          <div>
            <h3 class="text-[13px] font-medium text-gray-500 dark:text-slate-400 mb-3">Source</h3>
            <ul class="space-y-1.5">
              {visibleSources.map(({ value, count, label }) => (
                <li>
                  <button
                    type="button"
                    class="filter-row group flex w-full items-center justify-between text-left text-sm text-gray-700 dark:text-slate-300 hover:text-primary transition-colors"
                    data-group="source"
                    data-value={value}
                  >
                    <span class="filter-label">{label}</span>
                    <span class="text-xs tabular-nums text-gray-400 dark:text-slate-500">{count}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>

      <!-- Results -->
      <div class="min-w-0">
        <!-- Active filter pills + count -->
        <div class="flex flex-wrap items-center gap-2 mb-5 min-h-[28px]">
          <span id="jobs-count" class="text-sm text-gray-500 dark:text-slate-400" aria-live="polite"></span>
          <div id="active-filters" class="flex flex-wrap gap-1.5"></div>
        </div>

        <div id="jobs-list" class="grid gap-4">
          {sortedJobs.map((job) => (
            <article
              class="job-card rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-5 transition hover:-translate-y-0.5 hover:shadow-lg hover:border-primary/40"
              data-mode={job.workMode}
              data-type={job.type}
              data-source={job.source}
              data-city={job.city}
              data-search={[job.title, job.company, job.location, job.type, job.contractType, job.experience]
                .filter(Boolean)
                .join(' ')
                .toLowerCase()}
            >
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2 flex-wrap">
                    <h3 class="text-base md:text-lg font-semibold dark:text-white">{job.title}</h3>
                    <span class="text-[10px] uppercase tracking-wider rounded-full bg-green-50 dark:bg-green-500/15 text-green-700 dark:text-green-300 px-2 py-0.5">
                      {job.sourceLabel}
                    </span>
                  </div>
                  <p class="mt-1 text-sm text-gray-600 dark:text-slate-400">
                    <span class="font-medium">{job.company || 'Unknown company'}</span>
                    {job.city && <> · {job.city}</>}
                    {job.workMode !== 'unknown' && <> · {MODE_LABEL[job.workMode] || job.workMode}</>}
                  </p>
                  <div class="mt-2 flex flex-wrap gap-1.5 text-xs text-gray-500 dark:text-slate-400">
                    {job.type && <span>· {job.type}</span>}
                    {job.experience && <span>· {job.experience}</span>}
                    {job.postedDate && <span>· Posted {job.postedDate}</span>}
                  </div>
                </div>
                <div class="shrink-0">
                  <a
                    href={job.url}
                    target="_blank"
                    rel="noopener nofollow"
                    class="inline-flex items-center justify-center rounded-full bg-primary px-5 py-2 text-sm font-semibold text-white shadow hover:opacity-90 transition"
                  >
                    Apply on {job.sourceLabel}
                    <span aria-hidden="true" class="ml-1">↗</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <p id="jobs-empty" class="hidden mt-12 text-sm text-gray-500 dark:text-slate-400">
          Nothing matches. Try fewer filters, or different words.
        </p>

        <!-- Pagination -->
        <nav id="jobs-pagination" class="hidden mt-10 flex flex-wrap items-center justify-between gap-2" aria-label="Jobs pagination">
          <button id="jobs-prev" type="button" class="text-sm text-gray-600 dark:text-slate-400 hover:text-primary disabled:opacity-30 disabled:cursor-not-allowed" disabled>
            ← Previous
          </button>
          <span id="jobs-page-info" class="text-xs text-gray-400 dark:text-slate-500"></span>
          <button id="jobs-next" type="button" class="text-sm text-gray-600 dark:text-slate-400 hover:text-primary disabled:opacity-30 disabled:cursor-not-allowed">
            Next →
          </button>
        </nav>
      </div>
    </div>
  </section>

  <!-- Hiring CTA -->
  <CallToAction
    title="Hiring? Post a job — free."
    subtitle="WhatsApp us your job description and we'll list it within 24 hours. No fees, no friction. Built to help Pakistan tech teams find talent without the noise."
    actions={[
      {
        variant: 'primary',
        target: '_blank',
        text: 'WhatsApp to post a job',
        href: 'https://wa.me/923070555515?text=Hi%2C%20I%27d%20like%20to%20post%20a%20job%20on%20the%20Launchbox%20Jobs%20Board.',
      },
    ]}
  />

  <script is:inline define:vars={{ PER_PAGE }}>
    (function () {
      const search = document.getElementById('jobs-search');
      const list = document.getElementById('jobs-list');
      const cards = Array.from(document.querySelectorAll('.job-card'));
      const empty = document.getElementById('jobs-empty');
      const count = document.getElementById('jobs-count');
      const activePills = document.getElementById('active-filters');
      const pagination = document.getElementById('jobs-pagination');
      const prevBtn = document.getElementById('jobs-prev');
      const nextBtn = document.getElementById('jobs-next');
      const pageInfo = document.getElementById('jobs-page-info');
      const FACETS = ['mode', 'type', 'source', 'city'];

      // Multi-select state: Set per facet group.
      const filters = {
        mode: new Set(),
        type: new Set(),
        source: new Set(),
        city: new Set(),
      };
      let searchQuery = '';
      let page = 1;
      let visibleCards = cards;

      // ---- URL state ----------------------------------------------------
      function readUrl() {
        const params = new URLSearchParams(location.search);
        searchQuery = (params.get('q') || '').toLowerCase();
        if (search) search.value = params.get('q') || '';
        for (const k of FACETS) {
          const v = params.get(k);
          if (v) filters[k] = new Set(v.split(',').filter(Boolean));
        }
      }
      function syncUrl() {
        const params = new URLSearchParams();
        if (searchQuery) params.set('q', searchQuery);
        for (const k of FACETS) {
          if (filters[k].size) params.set(k, [...filters[k]].join(','));
        }
        const qs = params.toString();
        history.replaceState(null, '', qs ? '?' + qs : location.pathname);
      }

      // ---- Filtering ----------------------------------------------------
      function recompute() {
        visibleCards = cards.filter((card) => {
          if (searchQuery && (card.dataset.search || '').indexOf(searchQuery) === -1) return false;
          for (const k of FACETS) {
            if (filters[k].size && !filters[k].has(card.dataset[k])) return false;
          }
          return true;
        });
        page = 1;
        render();
        syncUrl();
      }

      function render() {
        const total = visibleCards.length;
        const totalPages = Math.max(1, Math.ceil(total / PER_PAGE));
        if (page > totalPages) page = totalPages;
        const start = (page - 1) * PER_PAGE;
        const end = start + PER_PAGE;

        cards.forEach((c) => (c.style.display = 'none'));
        visibleCards.slice(start, end).forEach((c) => (c.style.display = ''));

        if (empty) empty.classList.toggle('hidden', total > 0);

        if (count) {
          count.textContent = total === 1 ? '1 job' : total + ' jobs';
        }

        renderActivePills();
        renderFilterRows();

        if (pagination) {
          pagination.classList.toggle('hidden', total <= PER_PAGE);
          if (pageInfo) pageInfo.textContent = page + ' of ' + totalPages;
          if (prevBtn) prevBtn.disabled = page <= 1;
          if (nextBtn) nextBtn.disabled = page >= totalPages;
        }
      }

      function renderActivePills() {
        if (!activePills) return;
        activePills.innerHTML = '';
        const items = [];
        if (searchQuery) items.push({ kind: 'q', value: searchQuery, label: '"' + searchQuery + '"' });
        for (const k of FACETS) {
          for (const v of filters[k]) items.push({ kind: k, value: v, label: prettyLabel(k, v) });
        }
        if (!items.length) return;
        for (const it of items) {
          const pill = document.createElement('button');
          pill.type = 'button';
          pill.className =
            'inline-flex items-center gap-1 rounded-full border border-gray-200 dark:border-slate-700 px-2.5 py-0.5 text-xs text-gray-600 dark:text-slate-300 hover:border-primary hover:text-primary transition-colors';
          pill.dataset.kind = it.kind;
          pill.dataset.value = it.value;
          pill.innerHTML = it.label + ' <span aria-hidden="true" class="text-gray-400">×</span>';
          pill.setAttribute('aria-label', 'Remove filter ' + it.label);
          pill.addEventListener('click', () => {
            if (it.kind === 'q') {
              searchQuery = '';
              if (search) search.value = '';
            } else {
              filters[it.kind].delete(it.value);
            }
            recompute();
          });
          activePills.appendChild(pill);
        }
      }

      function prettyLabel(kind, value) {
        if (kind === 'mode') {
          const map = { remote: 'Remote', hybrid: 'Hybrid', 'on-site': 'On-site' };
          return map[value] || value;
        }
        return value;
      }

      function renderFilterRows() {
        document.querySelectorAll('.filter-row').forEach((btn) => {
          const group = btn.dataset.group;
          const value = btn.dataset.value;
          const active = !!(group && value && filters[group] && filters[group].has(value));
          btn.classList.toggle('filter-row-active', active);
        });
      }

      // ---- Wire up ------------------------------------------------------
      readUrl();

      if (search) {
        search.addEventListener('input', (e) => {
          searchQuery = (e.target.value || '').trim().toLowerCase();
          recompute();
        });
      }

      document.querySelectorAll('.filter-row').forEach((btn) => {
        btn.addEventListener('click', () => {
          const group = btn.dataset.group;
          const value = btn.dataset.value;
          if (!group || !value || !filters[group]) return;
          if (filters[group].has(value)) {
            filters[group].delete(value);
          } else {
            filters[group].add(value);
          }
          recompute();
        });
      });

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          if (page > 1) {
            page--;
            render();
            window.scrollTo({ top: list ? list.offsetTop - 100 : 0, behavior: 'smooth' });
          }
        });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          page++;
          render();
          window.scrollTo({ top: list ? list.offsetTop - 100 : 0, behavior: 'smooth' });
        });
      }

      recompute();
    })();
  </script>

  <style>
    .filter-row .filter-label {
      position: relative;
      display: inline-block;
    }
    .filter-row.filter-row-active {
      color: var(--aw-color-primary);
    }
    .filter-row.filter-row-active .filter-label::before {
      content: '';
      position: absolute;
      left: -10px;
      top: 50%;
      width: 4px;
      height: 4px;
      background: var(--aw-color-primary);
      border-radius: 9999px;
      transform: translateY(-50%);
    }
  </style>
</Layout>
