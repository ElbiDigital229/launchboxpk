---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
};

const whatsappHref =
  'https://wa.me/923070555515?text=Hi%2C%20I%27d%20like%20to%20know%20more%20about%20Launchbox%20coworking%20space.';
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="Contact"
    title="Message us on WhatsApp"
    subtitle="It's the fastest way to reach us — most messages get a reply within the hour, Mon–Sat 9–9."
  />

  <!-- WhatsApp CTA ******************* -->

  <CallToAction
    id="whatsapp"
    title="Chat with us now"
    subtitle="Tell us how you work and what you're looking for. We'll answer your questions and book you a walkthrough — no form to fill in, no waiting on email."
    actions={[
      {
        variant: 'primary',
        target: '_blank',
        text: 'WhatsApp +92 307 0555515',
        href: whatsappHref,
      },
      {
        text: 'Book a visit',
        href: '/book-visit',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Other ways to get in touch"
    subtitle="Pick whichever suits you. We answer all of them."
    items={[
      {
        title: 'Call us',
        description: '+92 307 0555515 — talk to a human, no IVR.',
        icon: 'tabler:phone',
      },
      {
        title: 'Email us',
        description: 'contact@launchboxpk.com — for longer questions or attachments.',
        icon: 'tabler:mail',
      },
      {
        title: 'Visit the space',
        description: 'First Floor, 38-A CCA, Sector C, DHA Phase 5, Lahore 54000.',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Follow us',
        description: '@launchboxpk on Instagram and Facebook for behind-the-scenes.',
        icon: 'tabler:brand-instagram',
      },
      {
        title: 'Book a free visit',
        description: 'Walk through the space, try a desk, no commitment, no sales pitch.',
        icon: 'tabler:door-enter',
      },
    ]}
  />
</Layout>
