---
import '@fontsource-variable/inter';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    /* Brand green — slightly darker than Spotify (#1DB954) */
    --aw-color-primary: rgb(26 163 74);   /* #1AA34A */
    --aw-color-secondary: rgb(20 132 60); /* #14843C */
    --aw-color-accent: rgb(29 185 84);    /* #1DB954 — Spotify green for accents */

    --aw-color-text-heading: rgb(0 0 0);
    --aw-color-text-default: rgb(16 16 16);
    --aw-color-text-muted: rgb(16 16 16 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(3 6 32);

    ::selection {
      background-color: lavender;
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    /* On dark, same Spotify-darker green — bright enough on slate without burn */
    --aw-color-primary: rgb(26 163 74);   /* #1AA34A */
    --aw-color-secondary: rgb(34 197 94); /* #22C55E — slightly lifted for hover on dark */
    --aw-color-accent: rgb(29 185 84);    /* #1DB954 */

    --aw-color-text-heading: rgb(247, 248, 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(3 6 32);

    ::selection {
      background-color: black;
      color: snow;
    }
  }
</style>
